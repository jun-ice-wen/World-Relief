# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Free Supabase Sync (for live sync across Mr Crocodile & Ms Hamster phones)
# Create a free project at https://supabase.com and copy your Project URL and anon public key.
# Leave blank to run in local browser storage mode.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional GitHub Pages base path (set automatically by .github/workflows/deploy.yml)
# Example: /world-relief-atlas/
VITE_BASE_PATH="/"
